# Nombre del contenedor y del repositorio ECR
SERVICE_NAME=ms-foro
# El contenedor queda en 127.0.0.1:HOST_PORT; Nginx de la EC2 lo publica en el puerto 80
HOST_PORT=8082
CONTAINER_PORT=8082
# Prueba dentro de la EC2
HEALTH_PATH=/actuator/health
# Prueba desde internet a través de Nginx (200, o 401/403 si el endpoint es protegido)
PUBLIC_SMOKE_PATH=/api/temas
NEEDS_DB=true
